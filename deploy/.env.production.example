# =============================================================================
# 生产环境变量模板
#
# 用法：复制成 deploy/.env 后逐项填写，**不要提交到版本库**（已在 .gitignore）。
# 容器部署时通过环境变量注入，镜像内不含任何 .env 文件。
#
# 与 Api-Serve/.env.example 的区别：那份是本地开发用的（含大量可选渠道配置），
# 这份是生产部署用的最小必要集合 + 容器相关变量。
# =============================================================================

# ---------- 1. 运行环境 ----------
# 生产必须是 production：会启用 JSON 日志、关闭 Swagger、关闭 mock 支付
APP_ENV=production
DEBUG=False
APP_PORT=8000

# 前端域名（CORS 白名单，逗号分隔）。必须与浏览器地址栏完全一致，含协议与端口
# 三个前端各自一个域名：平台端 admin / 商家端 merchant / 收银台 cashier
ALLOWED_ORIGINS=https://admin.example.com,https://merchant.example.com,https://cashier.example.com
# 允许的 Host（防 Host 头攻击）。填实际对外域名
ALLOWED_HOSTS=admin.example.com,merchant.example.com,cashier.example.com,api.example.com

# 信任的反向代理跳数。容器前面通常有一层网关/负载均衡，填 1；
# 不填则生产默认 1。填错会导致限流把全站算作同一个来源、审计日志记录到代理 IP
TRUST_PROXY=1

# ---------- 2. 数据库 ----------
DB_HOST=mysql
DB_PORT=3306
DB_USER=ye_dc
DB_PASSWORD=<填写强口令>
DB_NAME=ye_dc
DB_POOL_SIZE=10

# 生产专用覆盖项（可选）：填了就用它，不填则回退到上面的 DB_*
# PROD_DB_HOST=
# PROD_DB_PASSWORD=

# ---------- 3. Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<填写强口令>
REDIS_DB=0

# ---------- 4. JWT ----------
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET_KEY=<必填：至少 16 位随机串>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---------- 5. 接口限流 ----------
# 统计窗口（毫秒）与窗口内单来源上限；计数落在 Redis，多副本共享配额
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=600
# 登录/换令牌接口的上限，刻意比通用值严得多
THROTTLE_LOGIN_LIMIT=10

# ---------- 6. 图片存储 ----------
# local：写容器本地磁盘（**多副本会丢图**，仅单机或挂了共享卷时可用）
# s3   ：写 S3 兼容对象存储（腾讯云 COS / 阿里云 OSS / MinIO），多副本部署必须用这个
UPLOAD_DRIVER=local
UPLOAD_MAX_MB=5

# UPLOAD_DRIVER=s3 时以下全部必填，缺任何一项服务会在启动阶段直接报错
# S3_BUCKET=ye-dc-uploads
# S3_REGION=ap-guangzhou
# 自建网关或云厂商的 endpoint；留空则用 AWS 默认端点
# S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# 自建 MinIO 用路径风格（true）；云厂商对象存储用虚拟主机风格（false）
# S3_FORCE_PATH_STYLE=False
# 对外可访问前缀，用于拼出写库的图片绝对地址
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# ---------- 7. 敏感配置加密主密钥 ----------
# 支付渠道密钥等敏感配置入库时的 AES-256-GCM 主密钥（32 字节）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 这把钥匙必须留在环境变量里，不能进数据库或后台，否则加密失去意义
CONFIG_ENCRYPTION_KEY=<必填：32 字节密钥>

# ---------- 8. 支付渠道（按需填写，缺配置的渠道下单时会被明确拒绝）----------
# 注意：生产环境 MOCK_PAY_ENABLED 恒为失效，未接真实渠道时无法完成支付
MOCK_PAY_ENABLED=True

# --- 微信支付（服务商模式）---
WECHAT_PAY_SP_APPID=
WECHAT_PAY_SP_MCHID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MCH_CERT_SERIAL_NO=
WECHAT_PAY_MCH_PRIVATE_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=

# --- 支付宝 ---
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=False
ALIPAY_NOTIFY_URL=

# ---------- 9. 小程序 ----------
# 推荐在平台后台「小程序配置」里维护（加密入库）；这里只是首次部署的兜底值
MINI_APP_ID=
MINI_APP_SECRET=
# 生成桌位小程序码用的版本：release | trial | develop。
# 小程序未发布时用 release 会报 41030，先设 trial；发布后改回 release。
MINI_ENV_VERSION=release
# 桌位码落地页（不带前导斜杠），必须是 pages.json 里真实存在的页面
MINI_QR_PAGE=pages/index/index

# ---------- 10. 云打印机（可选，也可在平台后台配置）----------
FEIE_UID=
FEIE_API_KEY=
YILIANYUN_CLIENT_ID=
YILIANYUN_CLIENT_SECRET=
