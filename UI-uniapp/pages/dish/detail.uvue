<template>
  <view class="page">
    <scroll-view class="scroll" direction="vertical" :show-scrollbar="false">
      <!-- 顶部大图：高约屏高 1/3；无图时浅绿底 + 菜名首字兜底（与首页同一套做法） -->
      <image v-if="!failed && heroSrc.length > 0" class="hero" :src="heroSrc" mode="aspectFill"></image>
      <view v-else-if="!failed" class="hero hero-fallback">
        <text v-if="ready" class="hero-char">{{ heroChar }}</text>
      </view>

      <view v-if="failed" class="fail">
        <text class="fail-title">没有读到这道菜的信息</text>
        <text class="fail-desc">可能是门店换过了，或者这道菜已下架</text>
        <view class="fail-btn" @click="retry"><text class="fail-btn-text">重新加载</text></view>
      </view>

      <view v-else-if="!ready" class="pending">
        <text class="pending-text">{{ loading ? '菜品信息加载中…' : '暂无菜品信息' }}</text>
      </view>

      <!-- 白卡上浮：顶部大圆角与大图衔接（规范 9.3） -->
      <view v-else class="card">
        <view class="title-row">
          <text class="title">{{ title }}</text>
          <view v-if="isRecommend" class="rec-tag"><text class="rec-tag-text">招牌</text></view>
        </view>

        <!-- 信息顺序：菜名/招牌 → 已售·单价·单位 → 价格 → 卖点标签 → 介绍 → 规格明细 → 加料口味 → 搭配推荐 -->
        <text class="meta">{{ salesText(salesCount) }} · ¥{{ amountText(basePrice) }}/{{ unitText }}</text>

        <view class="price-row">
          <text class="price">¥{{ amountText(showPrice) }}<text v-if="hasSkus" class="price-from">起</text></text>
          <text v-if="originText != ''" class="origin-price">{{ originText }}</text>
          <text v-if="promoTag != ''" class="promo-tag">{{ promoTag }}</text>
          <text v-if="soldOutNow" class="soldout">已售罄</text>
        </view>
        <text v-if="memberTip != ''" class="member-tip">{{ memberTip }}</text>

        <view v-if="tags.length > 0" class="tag-row">
          <view v-for="tag in tags" :key="tag" class="tag"><text class="tag-text">{{ tag }}</text></view>
        </view>

        <view v-if="intro.length > 0" class="block">
          <text class="block-title">菜品介绍</text>
          <text class="desc">{{ intro }}</text>
        </view>

        <view v-if="hasSkus" class="block">
          <text class="block-title">份量</text>
          <view v-for="sku in skus" :key="sku.id" class="spec-row">
            <view class="spec-main">
              <text class="spec-name">{{ sku.name }}{{ deltaText(sku.priceDelta) }}</text>
              <text class="spec-desc">{{ sku.specDesc == null ? '' : sku.specDesc! }}</text>
            </view>
            <text v-if="sku.soldOut" class="spec-off">售罄</text>
            <text v-else class="spec-price">¥{{ amountText(sku.price) }}</text>
          </view>
        </view>

        <view v-for="group in groups" :key="group.id" class="block">
          <text class="block-title">{{ group.name }}<text v-if="group.required" class="block-required">*必选</text><text v-else class="block-optional">（{{ group.type == 'multi' ? '可多选' : '单选' }}）</text></text>
          <view class="chips">
            <view v-for="option in group.options" :key="option.name" class="chip">
              <text class="chip-text">{{ option.name }}{{ deltaText(option.priceDelta) }}</text>
            </view>
          </view>
        </view>

        <view v-if="related.length > 0" class="block">
          <text class="block-title">搭配推荐</text>
          <scroll-view class="rel-scroll" direction="horizontal" :show-scrollbar="false">
            <view class="rel-row">
              <view v-for="item in related" :key="item.id" class="rel-card" @click="goDish(item.id)">
                <image v-if="srcOf(item).length > 0" class="rel-thumb" :src="srcOf(item)" mode="aspectFill"></image>
                <view v-else class="rel-thumb rel-thumb-fallback">
                  <text class="rel-char">{{ firstChar(item.name) }}</text>
                </view>
                <text class="rel-name">{{ item.name }}</text>
                <text class="rel-price">¥{{ amountText(item.price) }}</text>
              </view>
            </view>
          </scroll-view>
        </view>

        <view class="bottom-space"></view>
      </view>
    </scroll-view>

    <!-- 底部固定操作栏：整宽主按钮，一屏只有这一个主色实心按钮 -->
    <view v-if="ready" class="action-bar">
      <view class="action-btn" @click="onAction"><text class="action-btn-text">{{ actionText }}</text></view>
    </view>

    <!-- 精简版规格弹窗（规范 8.5）：份量单选 + 加料多选，逻辑与点餐页同款 -->
    <view v-if="sheetOpen" class="mask" @click="closeSheet">
      <view class="sheet" @click.stop="noop">
        <view class="sheet-head">
          <image v-if="heroSrc.length > 0" class="sheet-thumb" :src="heroSrc" mode="aspectFill"></image>
          <view v-else class="sheet-thumb sheet-thumb-fallback">
            <text class="sheet-char">{{ heroChar }}</text>
          </view>
          <view class="sheet-head-main">
            <text class="sheet-name">{{ title }}</text>
            <text class="sheet-meta">{{ salesText(salesCount) }}</text>
            <text class="sheet-price">¥{{ amountText(sheetUnitPrice()) }}</text>
          </view>
          <view class="sheet-close" @click="closeSheet"><text class="sheet-close-text">×</text></view>
        </view>

        <scroll-view class="sheet-body" direction="vertical" :show-scrollbar="false">
          <view v-if="hasSkus" class="group">
            <text class="group-title">份量</text>
            <view class="chips">
              <view v-for="sku in skus" :key="sku.id" :class="sku.id == chosenSkuId ? 'chip chip-on' : 'chip'" @click="chooseSku(sku.id)">
                <text :class="sku.id == chosenSkuId ? 'chip-text-on' : 'chip-text'">{{ sku.name }}{{ deltaText(sku.priceDelta) }}</text>
              </view>
            </view>
          </view>

          <view v-for="group in groups" :key="group.id" class="group">
            <text class="group-title">{{ group.name }}<text v-if="group.required" class="group-required">*必选</text><text v-else class="group-optional">（{{ group.type == 'multi' ? '可多选' : '单选' }}）</text></text>
            <view class="chips">
              <view v-for="option in group.options" :key="option.name" :class="chipClass(group, option.name)" @click="toggleOption(group, option.name)">
                <text :class="isChosen(group, option.name) ? 'chip-text-on' : 'chip-text'">{{ option.name }}{{ deltaText(option.priceDelta) }}</text>
              </view>
            </view>
          </view>
          <view class="sheet-space"></view>
        </scroll-view>

        <view class="sheet-foot">
          <view class="stepper">
            <view class="minus" @click="stepSheet(-1)"><text class="minus-sign">−</text></view>
            <text class="step-num">{{ sheetQuantity }}</text>
            <view class="plus" @click="stepSheet(1)"><text class="plus-sign">+</text></view>
          </view>
          <view class="sheet-confirm" @click="confirmSheet">
            <text class="sheet-confirm-text">加入购物车 ¥{{ amountText(sheetUnitPrice() * sheetQuantity) }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { onLoad } from '@dcloudio/uni-app'
  import { fetchDish } from '../../common/api.uts'
  import { DishBrief, DishDetail, OptionGroup, Sku } from '../../common/models.uts'
  import { CartLine, CartOptionSelection, add, lineKey } from '../../common/cart.uts'
  import { amountText, imageUrl, salesText } from '../../common/format.uts'
  import {
    estimateUnitPrice,
    memberTipText,
    originPriceText,
    promoTagText,
    salePrice,
  } from '../../common/price.uts'
  import { toast } from '../../common/request.uts'

  const dishId = ref(0)
  const detail = ref<DishDetail | null>(null)
  const loading = ref(true)
  const failed = ref(false)

  // 规格弹窗：详情接口已经把份量和加料带回来了，弹窗不再二次请求
  const sheetOpen = ref(false)
  const chosenSkuId = ref(-1)
  const chosenMarks = ref<string[]>([] as string[])
  const sheetQuantity = ref(1)

  /** 页面里所有可读字段都过一次 computed，模板不出现判空，字段缺失时退回空值而不是崩。 */
  function dishNow() : DishBrief | null {
    const value = detail.value
    if (value == null) {
      return null
    }
    return value!.dish
  }

  const ready = computed(() : boolean => detail.value != null)
  const title = computed(() : string => {
    const value = dishNow()
    return value == null ? '' : value!.name
  })
  const heroSrc = computed(() : string => {
    const value = dishNow()
    if (value == null) {
      return ''
    }
    return imageUrl(value!.image)
  })
  const heroChar = computed(() : string => {
    const name = title.value
    return name.length == 0 ? '菜' : name.substring(0, 1)
  })
  const basePrice = computed(() : number => {
    const value = dishNow()
    return value == null ? 0 : value!.price
  })
  const unitText = computed(() : string => {
    const value = dishNow()
    return value == null ? '份' : value!.unit
  })
  const salesCount = computed(() : number => {
    const value = dishNow()
    return value == null ? 0 : value!.salesCount
  })
  const memberDiscount = computed(() : number => {
    const value = dishNow()
    return value == null ? 0 : value!.memberDiscount
  })
  /** 详情页主价格：有活动显示活动价，会员价仍只作一行提示 */
  const showPrice = computed(() : number => {
    const value = dishNow()
    return value == null ? 0 : salePrice(value!)
  })
  const originText = computed(() : string => {
    const value = dishNow()
    return value == null ? '' : originPriceText(value!)
  })
  const promoTag = computed(() : string => {
    const value = dishNow()
    return value == null ? '' : promoTagText(value!)
  })
  const memberTip = computed(() : string => {
    const value = dishNow()
    return value == null ? '' : memberTipText(value!)
  })
  const isRecommend = computed(() : boolean => {
    const value = dishNow()
    return value == null ? false : value!.isRecommend
  })
  const soldOutNow = computed(() : boolean => {
    const value = dishNow()
    return value == null ? false : value!.soldOut
  })
  const tags = computed(() : string[] => {
    const value = dishNow()
    return value == null ? ([] as string[]) : value!.tags
  })
  const intro = computed(() : string => {
    const value = detail.value
    if (value == null) {
      return ''
    }
    const text = value!.description
    return text == null ? '' : text!
  })
  const skus = computed(() : Sku[] => {
    const value = detail.value
    return value == null ? ([] as Sku[]) : value!.skus
  })
  const groups = computed(() : OptionGroup[] => {
    const value = detail.value
    return value == null ? ([] as OptionGroup[]) : value!.optionGroups
  })
  const related = computed(() : DishBrief[] => {
    const value = detail.value
    return value == null ? ([] as DishBrief[]) : value!.related
  })
  const hasSkus = computed(() : boolean => skus.value.length > 0)
  const actionText = computed(() : string => {
    const value = dishNow()
    if (value == null) {
      return '加入购物车'
    }
    return value!.needChoose ? '选规格 加入购物车' : '加入购物车'
  })

  function firstChar(name: string) : string {
    return name.length == 0 ? '菜' : name.substring(0, 1)
  }

  /** 搭配推荐卡片没有图时用首字兜底，取不到就返回空串让模板走兜底块。 */
  function srcOf(item: DishBrief) : string {
    return imageUrl(item.image)
  }

  /** 差价一律明示在标签里（规范 8.3），没有差价就不加后缀。 */
  function deltaText(delta: number) : string {
    return delta > 0 ? ' +¥' + amountText(delta) : ''
  }

  async function load(id: number) : Promise<void> {
    loading.value = true
    failed.value = false
    const result = await fetchDish(id)
    detail.value = result
    failed.value = result == null
    loading.value = false
    if (result != null) {
      uni.setNavigationBarTitle({ title: result!.dish.name })
    }
  }

  function retry() : void {
    if (dishId.value > 0) {
      load(dishId.value)
    }
  }

  /** 搭配推荐用 redirect 换页：详情页不该一层层堆栈。 */
  function goDish(id: number) : void {
    uni.redirectTo({ url: '/pages/dish/detail?id=' + id })
  }

  function openSheet() : void {
    chosenSkuId.value = -1
    chosenMarks.value = [] as string[]
    sheetQuantity.value = 1
    const list = skus.value
    // 只有一种份量的菜默认选中它，省一次点击（与点餐页弹窗一致）
    if (list.length == 1) {
      chosenSkuId.value = list[0].id
    }
    sheetOpen.value = true
  }

  function closeSheet() : void {
    sheetOpen.value = false
  }

  function noop() : void {}

  function chooseSku(id: number) : void {
    chosenSkuId.value = id
  }

  function groupMark(groupId: number, name: string) : string {
    return '' + groupId + '::' + name
  }

  function toggleOption(group: OptionGroup, name: string) : void {
    const mark = groupMark(group.id, name)
    const index = chosenMarks.value.indexOf(mark)
    if (index >= 0) {
      chosenMarks.value.splice(index, 1)
      return
    }
    if (group.type == 'single') {
      // 单选组：先清掉同组的旧选择
      chosenMarks.value = chosenMarks.value.filter((item) => !item.startsWith(groupMark(group.id, '')))
    }
    chosenMarks.value.push(mark)
  }

  function isChosen(group: OptionGroup, name: string) : boolean {
    return chosenMarks.value.indexOf(groupMark(group.id, name)) >= 0
  }

  function chipClass(group: OptionGroup, name: string) : string {
    return isChosen(group, name) ? 'chip chip-on' : 'chip'
  }

  function chosenGroupIds() : number[] {
    return chosenMarks.value.map((item) => parseInt(item.split('::')[0]))
  }

  /** 弹窗单价：基础价 + 份量差价 + 加料差价，登录后再减会员立减额。 */
  function sheetUnitPrice() : number {
    const value = dishNow()
    if (value == null) {
      return 0
    }
    let price = value!.price
    const sku = skus.value.find((item) => item.id == chosenSkuId.value)
    if (sku != null) {
      price += sku!.priceDelta
    }
    for (const mark of chosenMarks.value) {
      const parts = mark.split('::')
      const group = groups.value.find((item) => item.id == parseInt(parts[0]))
      if (group == null) {
        continue
      }
      const option = group!.options.find((item) => item.name == parts[1])
      if (option != null) {
        price += option!.priceDelta
      }
    }
    return estimateUnitPrice(value!, price)
  }

  function stepSheet(delta: number) : void {
    sheetQuantity.value = Math.max(sheetQuantity.value + delta, 1)
  }

  function confirmSheet() : void {
    const target = dishNow()
    if (target == null) {
      return
    }
    const list = skus.value
    if (list.length > 0 && chosenSkuId.value <= 0) {
      toast('请选择份量')
      return
    }
    const missing = groups.value.find((group) => group.required && chosenGroupIds().indexOf(group.id) < 0)
    if (missing != null) {
      toast('请选择' + missing!.name)
      return
    }
    const sku = list.find((item) => item.id == chosenSkuId.value)
    const selections: CartOptionSelection[] = []
    const summaryParts: string[] = []
    for (const group of groups.value) {
      const names: string[] = []
      for (const option of group.options) {
        if (isChosen(group, option.name)) {
          names.push(option.name)
          summaryParts.push(option.priceDelta > 0 ? option.name + ' +¥' + amountText(option.priceDelta) : option.name)
        }
      }
      if (names.length > 0) {
        const selection: CartOptionSelection = { groupId: group.id, optionNames: names }
        selections.push(selection)
      }
    }
    const line: CartLine = {
      key: lineKey(target.id, sku == null ? -1 : sku!.id, selections),
      dishId: target.id,
      categoryId: target.categoryId,
      name: target.name,
      image: target.image,
      skuId: sku == null ? -1 : sku!.id,
      skuName: sku == null ? '' : sku!.name,
      optionSummary: summaryParts.join(' / '),
      selections: selections,
      basePrice: target.price,
      unitPrice: sheetUnitPrice(),
      quantity: sheetQuantity.value,
    }
    add(line)
    closeSheet()
    toast('已加入购物车')
    uni.navigateBack()
  }

  /** 无规格无加料的菜直接落一行，key 与首页/点餐页保持一致。 */
  function addPlain(target: DishBrief) : void {
    const price = estimateUnitPrice(target, target.price)
    const line: CartLine = {
      key: lineKey(target.id, -1, []),
      dishId: target.id,
      categoryId: target.categoryId,
      name: target.name,
      image: target.image,
      skuId: -1,
      skuName: '',
      optionSummary: '',
      selections: [],
      basePrice: target.price,
      unitPrice: price,
      quantity: 1,
    }
    add(line)
    toast('已加入购物车')
    uni.navigateBack()
  }

  function onAction() : void {
    const value = dishNow()
    if (value == null) {
      toast('菜品信息还在加载中');
      return
    }
    if (value!.soldOut) {
      toast('该菜品已售罄');
      return
    }
    if (value!.needChoose) {
      openSheet();
      return
    }
    addPlain(value!)
  }

  onLoad((options: OnLoadOptions) => {
    const raw = options['id']
    if (raw != null) {
      const id = parseInt(raw as string)
      if (id > 0) {
        dishId.value = id
        load(id)
        return
      }
    }
    loading.value = false
    failed.value = true
    toast('菜品编号有误')
  })
</script>

<style lang="scss">
  .page {
    flex: 1;
    background-color: $page-bg;
  }

  .scroll {
    flex: 1;
  }

  /* 顶部大图 */
  .hero {
    width: 100%;
    height: 500rpx;
    background-color: $brand-bg;
  }

  .hero-fallback {
    justify-content: center;
    align-items: center;
  }

  .hero-char {
    font-size: 120rpx;
    font-weight: $semibold;
    color: $brand;
  }

  /* 上浮白卡 */
  .card {
    margin-top: -40rpx;
    padding-left: $page-padding;
    padding-right: $page-padding;
    padding-top: $space-5;
    background-color: $card-bg;
    border-top-left-radius: $radius-card;
    border-top-right-radius: $radius-card;
  }

  .pending {
    margin-top: -40rpx;
    padding: $space-6;
    background-color: $card-bg;
    border-top-left-radius: $radius-card;
    border-top-right-radius: $radius-card;
    align-items: center;
  }

  .pending-text {
    font-size: $font-body;
    color: $text-3;
  }

  .title-row {
    flex-direction: row;
    align-items: center;
  }

  .title {
    flex: 1;
    font-size: $font-h2;
    font-weight: $semibold;
    color: $text-1;
    lines: 1;
    text-overflow: ellipsis;
  }

  /* 招牌标签 = 规范 8.6 的进行中标签 */
  .rec-tag {
    margin-left: $space-2;
    padding-left: $space-2;
    padding-right: $space-2;
    height: 40rpx;
    background-color: $brand-light;
    border-radius: $radius-tag;
    justify-content: center;
    align-items: center;
  }

  .rec-tag-text {
    font-size: $font-small;
    font-weight: $medium;
    color: $brand;
  }

  .meta {
    margin-top: $space-2;
    font-size: $font-caption;
    color: $text-3;
  }

  .price-row {
    flex-direction: row;
    align-items: baseline;
    margin-top: $space-3;
  }

  .price {
    font-size: $font-price;
    font-weight: $semibold;
    color: $brand;
  }

  .price-from {
    margin-left: $space-1;
    font-size: $font-caption;
    color: $text-3;
  }

  .origin-price {
    margin-left: $space-2;
    font-size: $font-body;
    color: $text-3;
    text-decoration: line-through;
  }

  .promo-tag {
    margin-left: $space-2;
    padding-left: $space-2;
    padding-right: $space-2;
    font-size: $font-small;
    color: $brand;
    background-color: $brand-light;
    border-radius: $radius-tag;
  }

  .soldout {
    margin-left: $space-2;
    padding-left: $space-2;
    padding-right: $space-2;
    font-size: $font-small;
    color: $text-3;
    background-color: $chip-bg;
    border-radius: $radius-tag;
  }

  .member-tip {
    margin-top: $space-1;
    font-size: $font-small;
    color: $text-3;
  }

  /* 卖点标签 */
  .tag-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: $space-3;
  }

  .tag {
    margin-right: $space-1;
    margin-bottom: $space-1;
    padding-left: $space-2;
    padding-right: $space-2;
    height: 40rpx;
    background-color: $brand-light;
    border-radius: $radius-tag;
    justify-content: center;
  }

  .tag-text {
    font-size: $font-small;
    color: $brand;
  }

  /* 分区 */
  .block {
    margin-top: $space-4;
    padding-top: $space-3;
    border-top: 1px solid $divider;
  }

  .block-title {
    font-size: $font-h3;
    font-weight: $medium;
    color: $text-1;
  }

  .block-required {
    font-size: $font-small;
    color: $price-red;
  }

  .block-optional {
    font-size: $font-small;
    color: $text-3;
  }

  .desc {
    margin-top: $space-2;
    font-size: $font-body;
    color: $text-2;
    line-height: $line-body;
  }

  /* 规格明细（只读） */
  .spec-row {
    flex-direction: row;
    align-items: center;
    margin-top: $space-3;
  }

  .spec-main {
    flex: 1;
  }

  .spec-name {
    font-size: $font-body;
    font-weight: $medium;
    color: $text-1;
    lines: 1;
