// 进店参数解析：小程序码 scene、分享参数、本地记忆三个来源都收在这里。
//
// 微信把 scene 整体 URL 编码后传进来（形如 m%3DM10001），
// 解码失败或格式不认识时返回空串，由页面自己跳到「选择门店」，不做任何猜测。

import { merchantCode, saveMerchantCode } from "./session.uts";

const SCENE_KEY = "m";

export function resolveEntryCode(options: OnLoadOptions): string {
  const fromScene = readOption(options, "scene");
  const fromQuery = readOption(options, "merchantCode");
  const code = normalizeScene(fromScene).length > 0
    ? normalizeScene(fromScene)
    : fromQuery.trim();
  if (code.length > 0) {
    saveMerchantCode(code);
    return code;
  }
  return merchantCode();
}

function readOption(options: OnLoadOptions, key: string): string {
  const value = options[key];
  if (value == null) {
    return "";
  }
  return value as string;
}

/** 兼容 `m=M10001`、`m=M10001&t=2`、以及整串就是商户编号的简写。 */
function normalizeScene(raw: string): string {
  if (raw.length == 0) {
    return "";
  }
  let decoded = raw;
  try {
    decoded = decodeURIComponent(raw);
  } catch (e) {
    decoded = raw;
  }
  const pairs = decoded.split(/[&;]/);
  for (let i = 0; i < pairs.length; i++) {
    const parts = pairs[i].split("=");
    if (parts.length == 2 && parts[0].trim().toLowerCase() == SCENE_KEY) {
      return parts[1].trim();
    }
  }
  const single = decoded.trim();
  return /^[A-Za-z0-9_-]{3,32}$/.test(single) ? single : "";
}
