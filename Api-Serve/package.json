{
  "name": "api-serve",
  "version": "1.0.0",
  "private": true,
  "description": "SaaS 多商户点餐系统后端服务 (NestJS 11 + TypeORM + MySQL + Redis)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "db:seed": "ts-node src/database/seeds/run-seed.ts",
    "smoke:platform-payment": "node scripts/smoke-platform-payment.cjs",
    "seed:payment-demo": "node scripts/seed-payment-demo.cjs",
    "seed:client-demo": "node scripts/seed-client-demo.cjs",
    "smoke:profit-share": "node scripts/smoke-profit-share.cjs",
    "smoke:reconcile": "node scripts/smoke-reconcile.cjs",
    "smoke:commission": "node scripts/smoke-commission.cjs",
    "smoke:client": "node scripts/smoke-client.cjs",
    "seed:dish-images": "node scripts/seed-dish-images.cjs",
    "seed:activity": "node scripts/seed-activity-demo.cjs",
    "smoke:activity": "node scripts/smoke-activity.cjs",
    "smoke:promotion": "node scripts/smoke-promotion.cjs",
    "smoke:upload": "node scripts/smoke-upload.cjs",
    "smoke:member": "node scripts/smoke-member.cjs",
    "smoke:print": "node scripts/smoke-print.cjs",
    "smoke:cashier": "node scripts/smoke-cashier.cjs",
    "smoke:sms": "node scripts/smoke-sms.cjs",
    "verify:sigv4": "node scripts/verify-sigv4.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "mysql2": "^3.11.5",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
