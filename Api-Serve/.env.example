# 复制成 .env 再按本机情况填写；.env 已被 .gitignore 忽略，不要提交。
# 本模板由 .env 生成，尖括号项都是必须替换的占位符。

# ==========================================
# 1. 环境基础配置
# ==========================================
# 环境标识：开发环境填 'development'，生产环境填 'production'
APP_ENV=development
#APP_ENV=production

# 应用调试模式：生产环境务必设为 False，开发环境可设为 True
DEBUG=True

# 应用监听端口
APP_PORT=8000

# 允许访问的域名/IP列表 (CORS 配置)
# 开发环境通常填前端本地地址，如 http://localhost:5173,http://localhost:5174
# 生产环境填正式域名，如 https://example.com
ALLOWED_ORIGINS=<ALLOWED_ORIGINS:逗号分隔，开发填前端本地地址，生产填正式域名>

# 允许的 Host 列表 (防止 Host 头攻击)
ALLOWED_HOSTS=<ALLOWED_HOSTS>

# ==========================================
# 2. 数据库配置 (MySQL)
# ==========================================
# 数据库主机地址
DB_HOST=127.0.0.1
# 数据库端口
DB_PORT=3306
# 数据库用户名
DB_USER=root
# 数据库密码
DB_PASSWORD=<DB_PASSWORD>
# 数据库名称
DB_NAME=APi-Serve
# 数据库连接池大小
DB_POOL_SIZE=5


# ==========================================
# 3. 缓存配置 (Redis)
# ==========================================
# Redis 主机地址
REDIS_HOST=127.0.0.1
# Redis 端口
REDIS_PORT=6379
# Redis 密码 (如果没有则留空)
REDIS_PASSWORD=<REDIS_PASSWORD_OR_EMPTY>
# Redis 数据库编号
REDIS_DB=0

# ==========================================
# 4. JWT 安全配置
# ==========================================
# JWT 密钥 (生产环境请务必使用复杂的随机字符串)
JWT_SECRET_KEY=<JWT_SECRET_KEY_GENERATE_YOUR_OWN>
# JWT 算法
JWT_ALGORITHM=HS256
# Token 过期时间 (单位：分钟)，例如 60 表示 1 小时
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# 4b. 图片上传配置（两项都可省略，用默认值）
# ==========================================
# 落盘目录，相对路径按 Api-Serve 解析；该目录已在 .gitignore 里
# UPLOAD_DIR=uploads
# 单张大小上限（MB），只认 jpg/png/gif/webp，按文件真实字节判断
# UPLOAD_MAX_MB=5

# ==========================================
# 5. 生产环境特定配置
# ==========================================
# 生产环境域名
PRODUCTION_DOMAIN=<PRODUCTION_DOMAIN>

# 以下三项是**可选覆盖项**：只有填了真实值才会生效，留空则回退到上面的 DB_* / REDIS_*。
# 注意别填占位符——它是「真值」，会让生产模式去连一个不存在的地址，
# 表现为服务起不来且日志里看不出原因。只有确实要连另一套库时才填。
# PROD_DB_HOST=
# PROD_DB_PASSWORD=
# PROD_REDIS_HOST=

# ==========================================
# 5b. 反向代理与限流
# ==========================================
# 信任的反向代理跳数。部署在 Nginx / 云负载均衡后面时必须 ≥ 1，
# 否则 req.ip 永远是代理地址：限流会把全站算作同一个来源，审计日志记录的 IP 也是假的。
# 留空时生产默认按 1 处理，开发默认 0。
# TRUST_PROXY=1

# 接口限流：统计窗口（毫秒）、窗口内单来源上限、登录接口上限
# 计数落在 Redis，多副本共享配额。留空用默认值 60000 / 600 / 10
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=600
# THROTTLE_LOGIN_LIMIT=10

# ==========================================
# 5c. 图片存储
# ==========================================
# local（默认，写本地磁盘）或 s3（S3 兼容对象存储）。
# 多副本部署必须用 s3，否则上传的图会散落在各个副本的本地磁盘上、互相看不到。
# UPLOAD_DRIVER=local
#
# 选 s3 时以下全部必填，缺任何一项服务会在启动阶段直接报错：
# S3_BUCKET=
# S3_REGION=ap-guangzhou
# S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=False
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# ==========================================
# 6. 支付渠道配置
# ==========================================
# 说明：以下凭据全部可选。缺凭据的渠道在下单时会被明确拒绝（"尚未完成配置"），
# 不影响服务启动；MOCK_PAY_ENABLED 仅在 APP_ENV=development 时生效。

# --- 微信支付（服务商模式）---
# 服务商 AppID
WECHAT_PAY_SP_APPID=
# 服务商商户号
WECHAT_PAY_SP_MCHID=
# APIv3 密钥（32 位）
WECHAT_PAY_API_V3_KEY=
# 商户 API 证书序列号
WECHAT_PAY_MCH_CERT_SERIAL_NO=
# 商户私钥文件路径（apiclient_key.pem）
WECHAT_PAY_MCH_PRIVATE_KEY_PATH=
# 微信支付公钥 ID（新商户号为公钥模式，形如 PUB_KEY_ID_xxx）
WECHAT_PAY_PUBLIC_KEY_ID=
# 微信支付公钥文件路径
WECHAT_PAY_PUBLIC_KEY_PATH=
# 支付结果通知地址（必须为 https 公网地址）
WECHAT_PAY_NOTIFY_URL=

# --- 支付宝（ISV / 自研应用）---
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=True
ALIPAY_NOTIFY_URL=

# --- 模拟渠道：跑通下单-回调-退款-关单全链路，生产自动失效 ---
MOCK_PAY_ENABLED=True

# 支付等敏感配置写入数据库时的 AES-256-GCM 主密钥（32 字节，base64/hex/原文均可）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 注意：这把钥匙本身必须留在 .env，不能搬进后台或数据库，否则加密就失去意义。
CONFIG_ENCRYPTION_KEY=<CONFIG_ENCRYPTION_KEY_BASE64_32_BYTES>

# --- 短信验证码（手机号验证码登录用；全部可选）---
#
# 推荐落库：平台后台「系统设置 → 短信配置」录入，密钥用上面那把
# CONFIG_ENCRYPTION_KEY 加密进 `sms_config` 表、接口只回掩码 + 指纹。
# 下面这几项只是首次部署的兜底值 —— 数据库里没保存过行时才会被读到；
# 一旦在后台保存过，就以数据库为准。短信签名要按主体过云厂商审核、一套凭据服务全部商户，
# 所以商家端与门店端都没有入口，顾客端更碰不到。
#
# 四个通道（SMS_DRIVER）：
#   log      只把验证码写进服务日志（仅开发环境允许，生产用它会拒绝发送）
#   aliyun   阿里云短信 Dysmsapi，需要 AccessKey + 签名 + 模板 CODE
#   tencent  腾讯云短信 API 3.0，需要 SecretId/SecretKey + SdkAppId + 签名 + 模板 ID
#   custom   自定义 HTTP 网关（运营商或第三方小通道）：POST JSON，2xx 即算发送成功
# 下面这几组按 SMS_DRIVER 选中的那一个通道生效：后台把通道换成另一家时，
# 这里给上一家准备的凭据与地域不会被当成新通道的值继续用。
# 没配通道的顾客仍然可以走「微信手机号一键登录」，只是没有验证码这条路。
SMS_DRIVER=log

# 短信签名，如「川味小馆」；须是云厂商审核通过的那个名字
SMS_SIGN_NAME=
# 验证码模板号：阿里云 SMS_123456789（变量名固定为 code）/ 腾讯云的数字模板 ID（变量位 {1} 只有一个）
SMS_TEMPLATE_CODE=
# 地域与网关地址：留空即按通道取官方默认（cn-hangzhou / ap-guangzhou，官方网关域名）
SMS_REGION=
SMS_ENDPOINT=

SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
# 腾讯云「云 API 密钥」是 SecretId + SecretKey，短信控制台「应用管理」里另有 SdkAppId
SMS_TENCENT_SECRET_ID=
SMS_TENCENT_SECRET_KEY=
SMS_TENCENT_SDK_APP_ID=
# 自定义网关：地址必填；鉴权头形如 `Authorization: Bearer {token}`，留空即不带鉴权头；
# 请求体模板必须是合法 JSON，占位符 {phone} {code} {signName} {templateCode} {token}
SMS_CUSTOM_ENDPOINT=
SMS_CUSTOM_AUTH_HEADER=
SMS_CUSTOM_BODY_TEMPLATE=
SMS_CUSTOM_TOKEN=

# --- 云打印机厂商凭据（全部可选，缺配置即该厂商不可用，不影响启动）---
#
# 推荐落库：平台后台「系统设置 → 云打印机配置」录入，密钥加密入库、只回掩码。
# 下面这几项只是首次部署的兜底值 —— 数据库里没配时才会被读到；
# 一旦在后台保存过，就以数据库为准。商家端永远只填设备号（sn），不接触这些密钥。
#
# 飞鹅（https://api.de.feieyun.com/Api/Open/）：
# FEIE_UID 填**飞鹅云后台的登录用户名**（一般是注册邮箱），不是 UUID 也不是数字 ID；
# FEIE_API_KEY 填 UKEY，在 developer.de.feieyun.com 的「个人中心」里。
# 打印机还要先绑定到这个账号下（后台添加 SN + 机身校验码），否则出纸会回「设备不存在」。
FEIE_UID=
FEIE_API_KEY=
# 仅联调沙箱或自建代理时需要；留空用官方地址
FEIE_BASE_URL=
#
# 易联云（https://open-api.10ss.net）：client_id / client_secret 在易联云开放平台创建应用后获得
YILIANYUN_CLIENT_ID=
YILIANYUN_CLIENT_SECRET=
YILIANYUN_BASE_URL=

# --- 顾客小程序凭据（登录与桌位小程序码都要用）---
#
# 推荐落库：平台后台「小程序配置」录入，AppSecret 加密入库、只回掩码。
# 下面两项只是首次部署的兜底值 —— 数据库里没配时才会被读到；后台保存过就以数据库为准。
# 没有配置时：顾客登录不可用，商家端「桌位管理」也制不出二维码。
MINI_APP_ID=
MINI_APP_SECRET=

# 生成桌位小程序码时的小程序版本：release（正式版）| trial（体验版）| develop（开发版）。
# 小程序尚未发布时用 release 会拿到 41030（page 不存在），先设成 trial 即可，不用改代码。
MINI_ENV_VERSION=release

# 桌位码扫码后落地的小程序页面（不带前导斜杠），该页 onLoad 会收到 scene。
# 必须是 pages.json 里真实存在的页面；默认首页。
MINI_QR_PAGE=pages/index/index
