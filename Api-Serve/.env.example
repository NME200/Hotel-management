# 复制成 .env 再按本机情况填写；.env 已被 .gitignore 忽略，不要提交。
# 本模板由 .env 生成，尖括号项都是必须替换的占位符。

# ==========================================
# 1. 环境基础配置
# ==========================================
# 环境标识：开发环境填 'development'，生产环境填 'production'
APP_ENV=development
#APP_ENV=production

# 应用调试模式：生产环境务必设为 False，开发环境可设为 True
DEBUG=True

# 应用监听端口
APP_PORT=8000

# 允许访问的域名/IP列表 (CORS 配置)
# 开发环境通常填前端本地地址，如 http://localhost:5173,http://localhost:5174
# 生产环境填正式域名，如 https://example.com
ALLOWED_ORIGINS=<ALLOWED_ORIGINS:逗号分隔，开发填前端本地地址，生产填正式域名>

# 允许的 Host 列表 (防止 Host 头攻击)
ALLOWED_HOSTS=<ALLOWED_HOSTS>

# ==========================================
# 2. 数据库配置 (MySQL)
# ==========================================
# 数据库主机地址
DB_HOST=127.0.0.1
# 数据库端口
DB_PORT=3306
# 数据库用户名
DB_USER=root
# 数据库密码
DB_PASSWORD=<DB_PASSWORD>
# 数据库名称
DB_NAME=APi-Serve
# 数据库连接池大小
DB_POOL_SIZE=5


# ==========================================
# 3. 缓存配置 (Redis)
# ==========================================
# Redis 主机地址
REDIS_HOST=127.0.0.1
# Redis 端口
REDIS_PORT=6379
# Redis 密码 (如果没有则留空)
REDIS_PASSWORD=<REDIS_PASSWORD_OR_EMPTY>
# Redis 数据库编号
REDIS_DB=0

# ==========================================
# 4. JWT 安全配置
# ==========================================
# JWT 密钥 (生产环境请务必使用复杂的随机字符串)
JWT_SECRET_KEY=<JWT_SECRET_KEY_GENERATE_YOUR_OWN>
# JWT 算法
JWT_ALGORITHM=HS256
# Token 过期时间 (单位：分钟)，例如 60 表示 1 小时
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ==========================================
# 5. 生产环境特定配置 (当 APP_ENV=production 时生效)
# ==========================================
# 生产环境域名
PRODUCTION_DOMAIN=<PRODUCTION_DOMAIN>
# 生产环境数据库地址 (通常与开发环境不同)
PROD_DB_HOST=<PROD_DB_HOST>
PROD_DB_PASSWORD=<PROD_DB_PASSWORD>
# 生产环境 Redis 地址
PROD_REDIS_HOST=<PROD_REDIS_HOST>

# ==========================================
# 6. 支付渠道配置
# ==========================================
# 说明：以下凭据全部可选。缺凭据的渠道在下单时会被明确拒绝（"尚未完成配置"），
# 不影响服务启动；MOCK_PAY_ENABLED 仅在 APP_ENV=development 时生效。

# --- 微信支付（服务商模式）---
# 服务商 AppID
WECHAT_PAY_SP_APPID=
# 服务商商户号
WECHAT_PAY_SP_MCHID=
# APIv3 密钥（32 位）
WECHAT_PAY_API_V3_KEY=
# 商户 API 证书序列号
WECHAT_PAY_MCH_CERT_SERIAL_NO=
# 商户私钥文件路径（apiclient_key.pem）
WECHAT_PAY_MCH_PRIVATE_KEY_PATH=
# 微信支付公钥 ID（新商户号为公钥模式，形如 PUB_KEY_ID_xxx）
WECHAT_PAY_PUBLIC_KEY_ID=
# 微信支付公钥文件路径
WECHAT_PAY_PUBLIC_KEY_PATH=
# 支付结果通知地址（必须为 https 公网地址）
WECHAT_PAY_NOTIFY_URL=

# --- 支付宝（ISV / 自研应用）---
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=True
ALIPAY_NOTIFY_URL=

# --- 模拟渠道：跑通下单-回调-退款-关单全链路，生产自动失效 ---
MOCK_PAY_ENABLED=True

# 支付等敏感配置写入数据库时的 AES-256-GCM 主密钥（32 字节，base64/hex/原文均可）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 注意：这把钥匙本身必须留在 .env，不能搬进后台或数据库，否则加密就失去意义。
CONFIG_ENCRYPTION_KEY=<CONFIG_ENCRYPTION_KEY_BASE64_32_BYTES>
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
